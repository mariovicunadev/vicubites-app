{% doc %}
  One Refill Radar forecast line, with the bag last bought and a way to buy it again.

  @param {string} species - 'dog' or 'cat'
  @param {string} run_out_on - Run-out date, YYYY-MM-DD
  @param {string} basis - 'estimate' or 'cadence'
  @param {variant} [variant] - Last bag bought; no action when blank
  @param {boolean} [sample] - Theme editor sample: placeholder bag, inert button
{% enddoc %}
{%- liquid
  if species == 'cat'
    assign pet = 'refill.pets.cat' | t
  else
    assign pet = 'refill.pets.dog' | t
  endif
  if basis == 'cadence'
    assign basis_text = 'refill.basis.cadence' | t
  else
    assign basis_text = 'refill.basis.estimate' | t
  endif
  assign run_out_date = run_out_on | date: '%B %-d'
  assign today_s = 'now' | date: '%Y-%m-%d' | date: '%s' | plus: 0
  assign run_out_s = run_out_on | date: '%s' | plus: 0
  assign days_left = run_out_s | minus: today_s | divided_by: 86400
  if days_left < 0
    assign bucket = 'overdue'
  elsif days_left <= 7
    assign bucket = '0-7'
  elsif days_left <= 14
    assign bucket = '8-14'
  else
    assign bucket = '15+'
  endif

  # Escaped once here: the t filter already escapes the sample text.
  if sample
    assign bag_name = 'refill.sample_bag' | t
  elsif variant != blank
    assign bag_name = variant.product.title | append: ' · ' | append: variant.title | escape
  endif
-%}
<li class="vb-refill__item" data-refill-species="{{ species | escape }}" data-refill-bucket="{{ bucket }}">
  <p class="vb-refill__date">
    {%- if days_left < 0 -%}
      {{ 'refill.ran_out_html' | t: pet: pet, date: run_out_date }}
    {%- else -%}
      {{ 'refill.runs_out_html' | t: pet: pet, date: run_out_date }}
    {%- endif -%}
  </p>
  {%- if bag_name != blank -%}
    <p class="vb-refill__bag">{{ bag_name }}</p>
  {%- endif -%}
  <p class="vb-refill__basis">{{ basis_text }}</p>
  {%- if sample -%}
    <button type="button" class="vb-refill__button">{{ 'refill.reorder' | t }}</button>
  {%- elsif variant.available -%}
    <form action="{{ routes.cart_add_url }}" method="post" class="vb-refill__form">
      <input type="hidden" name="id" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="1">
      <button type="submit" class="vb-refill__button">
        {{- 'refill.reorder' | t -}}
        <span class="vb-refill__hidden"> {{ bag_name }}</span>
      </button>
    </form>
  {%- elsif variant != blank -%}
    <a class="vb-refill__link" href="{{ variant.product.url }}">
      {{- 'refill.view_product' | t -}}
      <span class="vb-refill__hidden"> {{ bag_name }}</span>
    </a>
  {%- endif -%}
</li>
