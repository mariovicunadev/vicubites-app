// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "sqlite"
  url      = "file:dev.sqlite"
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

// One row per bulk operation the app starts. Shopify keeps result files for
// seven days; this table keeps the history and the state the UI shows.
model BulkJob {
  id              String    @id @default(cuid())
  shop            String
  operationId     String    @unique
  kind            String
  status          String
  errorCode       String?
  objectCount     Int       @default(0)
  rootObjectCount Int       @default(0)
  url             String?
  partialDataUrl  String?
  urlExpiresAt    DateTime?
  createdAt       DateTime  @default(now())
  completedAt     DateTime?
  // Set once the result has been consumed (for example, an audit evaluated).
  processedAt     DateTime?
  fixRun          FixRun?

  @@index([shop, kind, createdAt])
}

// Latest Nutrition Data Health result per product, replaced on every audit.
model ProductHealth {
  id          String   @id @default(cuid())
  shop        String
  productId   String
  title       String
  handle      String
  status      String
  score       Int
  // JSON array of { ruleId, passed, missing } (SQLite has no JSON column type).
  results     String
  auditJobId  String
  auditedAt   DateTime

  @@unique([shop, productId])
  @@index([shop, score])
}

// A bulk fix: the plan reviewed in the preview, then the job that applied it.
// The plan's product order is the JSONL line order, so result lines map back.
model FixRun {
  id        String   @id @default(cuid())
  shop      String
  // JSON FixPlan (products with their changes, skipped rows).
  plan      String
  jobId     String?  @unique
  job       BulkJob? @relation(fields: [jobId], references: [id], onDelete: Cascade)
  // JSON array of FixOutcome, set once the job's result is processed.
  results   String?
  createdAt DateTime @default(now())

  @@index([shop, createdAt])
}
